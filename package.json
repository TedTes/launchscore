{
  "name": "launch-score",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "calibrate": "pnpm --filter @launchscore/scanner build && pnpm --filter launchscore build && node apps/cli/dist/index.js calibrate",
    "cf:build": "pnpm --filter web cf:build",
    "cf:deploy": "pnpm --filter web cf:deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @launchscore/scanner build && pnpm -r --filter '!@launchscore/scanner' typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
